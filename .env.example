# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is ONLY used server-side (server actions / edge functions). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single admin account for the site (must match the email the owner signs in with)
NEXT_PUBLIC_ADMIN_EMAIL=pundlikwjayale@gmail.com

# Used for absolute URLs in metadata / sitemap / emails
NEXT_PUBLIC_SITE_URL=https://www.shrinavnathconstructions.com

# Optional: only needed if you deploy the send-enquiry-email Supabase Edge Function
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=enquiries@shrinavnathconstructions.com
